# Student App (Vite) — leave VITE_API_URL empty in production so the app uses
# the relative '/api' path served by Vercel serverless functions.
# For local development against the local student backend:
VITE_API_URL=http://localhost:5001/api
VITE_ASSESSMENTS_PORTAL_URL=http://localhost:5174/login

# ─── Serverless API (Vercel project environment variables) ───
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# They are read ONLY by the serverless Express app in api/index.js.
DB_HOST=sqlXXX.hostinger.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=com_question_bank
DB_POOL_LIMIT=5
DB_SSL=false
JWT_SECRET=your_very_long_secret
JWT_EXPIRE=24h